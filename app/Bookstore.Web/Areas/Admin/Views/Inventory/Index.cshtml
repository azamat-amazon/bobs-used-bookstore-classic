@model Bookstore.Web.Areas.Admin.Models.Inventory.InventoryIndexViewModel

@{
    ViewData["Title"] = "Inventory";
}

<partial name="_MessageBanner" />

<div class="d-flex m-3">
    <h5 class="me-auto">Inventory</h5>
    <a asp-action="Create" asp-controller="Inventory" class="btn btn-primary">New Book</a>
</div>

<div class="card mx-3">
    <div class="card-body">
        <form class="row row-cols-lg-auto g-3 align-items-center" method="get">
            <div class="col-12">
                <label class="visually-hidden" for="NameFilterInput">Name</label>
                <input asp-for="Filters.Name" placeholder="Name" class="form-control" id="NameFilterInput" />
            </div>

            <div class="col-12">
                <label class="visually-hidden" for="AuthorFilterInput">Author</label>
                <input asp-for="Filters.Author" placeholder="Author" class="form-control" id="AuthorFilterInput" />
            </div>

            <div class="col-12">
                <label class="visually-hidden" for="PublisherFilter">Publisher</label>
                <select asp-for="Filters.PublisherId" asp-items="Model.Publishers" class="form-select">
                    <option value="">All Publishers</option>
                </select>
            </div>

            <div class="col-12">
                <label class="visually-hidden" for="GenreFilter">Genre</label>
                <select asp-for="Filters.GenreId" asp-items="Model.Genres" class="form-select">
                    <option value="">All Genres</option>
                </select>
            </div>

            <div class="col-12">
                <label class="visually-hidden" for="BookTypeFilter">Book type</label>
                <select asp-for="Filters.BookTypeId" asp-items="Model.BookTypes" class="form-select">
                    <option value="">All Book Types</option>
                </select>
            </div>

            <div class="col-12">
                <label class="visually-hidden" for="ConditionFilter">Condition</label>
                <select asp-for="Filters.ConditionId" asp-items="Model.BookConditions" class="form-select">
                    <option value="">All Book Conditions</option>
                </select>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Filters.LowStock" class="form-check-input" />
                    <label class="form-check-label" for="LowStockCheckbox">
                        Low stock
                    </label>
                </div>               
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>

            <div class="col-12">
                <a asp-action="Index" asp-controller="Inventory" class="btn btn-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card m-3">
    <div class="card-header">
        <div class="d-flex justify-content-end">
            <partial name="_Paginator" />
        </div>
    </div>

    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Author</th>
                    <th scope="col">Publisher</th>
                    <th scope="col">Genre</th>
                    <th scope="col">Type</th>
                    <th scope="col">Condition</th>
                    <th scope="col">Price</th>
                    <th scope="col">Stock Level</th>
                    <th scope="col">Updated</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Items)
                {
                    <tr>
                        <td>@book.Name</td>
                        <td>@book.Author</td>
                        <td>@book.Publisher</td>
                        <td>@book.Genre</td>
                        <td>@book.BookType</td>
                        <td>@book.Condition</td>
                        <td>@book.Price.ToString("C")</td>
                        <td>@book.Quantity</td>
                        <td>@book.UpdatedOn.ToShortDateString()</td>
                        <td>
                            <div class="hstack gap-2">

                                <a asp-action="Details" asp-controller="Inventory" asp-route-id="@book.Id" class="card-link">View</a>
                                <div class="vr"></div>                               
                                <a asp-action="Update" asp-controller="Inventory" asp-route-id="@book.Id" class="card-link">Update</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer">
        <div class="d-flex justify-content-end">
            <partial name="_Paginator" />
        </div>
    </div>
</div>
