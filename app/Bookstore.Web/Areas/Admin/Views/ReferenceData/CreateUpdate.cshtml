@using Bookstore.Domain.ReferenceData
@using Bookstore.Web.Helpers

@model Bookstore.Web.Areas.Admin.Models.ReferenceData.ReferenceDataItemCreateUpdateViewModel

<div asp-validation-summary="All"></div>

<div class="d-flex m-3">
    <h5 class="me-auto">Create / Update Reference Data</h5>
</div>

<form class="row justify-content-center" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="col-4">
        <div class="mb-3">
            <label for="referenceDataTypeSelect" class="form-label">Reference data type</label>
            <select asp-for="SelectedReferenceDataType" asp-items="Html.GetSelectListForEnum<ReferenceDataType>()" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label for="referenceDataTextInput" class="form-label">Text</label>
            <input asp-for="Text" type="text" class="form-control" required="required" id="referenceDataTextInput" />
        </div>

        <button class="btn btn-primary" type="submit">Save</button>
        <a asp-action="Index" asp-controller="ReferenceData" class="btn btn-secondary">Back</a>
    </div>
</form>
